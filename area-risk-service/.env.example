# ============================================================
# STREEVA — Area Risk Scoring Engine
# Environment Variables Template
# ============================================================
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.
# ============================================================

# --- Google Places API (New) ---
# Required. Get from: https://console.cloud.google.com/
# Enable: Places API (New)
GOOGLE_PLACES_API_KEY=your_google_places_api_key_here

# --- Service Configuration ---
# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# App environment: development | production
ENVIRONMENT=development

# --- City Configuration ---
# Used by MacroBaselineService to look up NCRB district key
CITY_NAME=Chennai

# --- Cache ---
# Base directory for disk cache (relative to project root)
CACHE_DIR=data/cache

# --- WorldPop Raster ---
# Path to the downloaded Tamil Nadu WorldPop GeoTIFF
# Run scripts/download_worldpop.py to populate this file
WORLDPOP_RASTER_PATH=data/raw/worldpop_tamilnadu_2020_100m.tif

# --- NCRB Lookup ---
# Path to the processed district lookup JSON
# Run scripts/ingest_ncrb.py to generate this file
NCRB_LOOKUP_PATH=data/processed/ncrb_district_lookup.json
